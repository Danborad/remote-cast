#!/bin/sh /etc/rc.common

START=95
STOP=10
USE_PROCD=1

PROG=/usr/sbin/remote-castd
STATE_DIR=/var/run/remote-cast
PID_FILE=$STATE_DIR/remote-cast.pid
STATE_FILE=$STATE_DIR/devices.json

append_allowed_tv_ip() {
	local value="$1"
	[ -n "$value" ] || return 0
	allowed_tv_ips="${allowed_tv_ips:+$allowed_tv_ips }$value"
}

start_service() {
	config_load remote-cast

	local enabled lan_iface easytier_iface phone_subnet allowed_tv_ips debug
	config_get_bool enabled main enabled 0
	[ "$enabled" -eq 1 ] || return 0

	config_get lan_iface main lan_iface "br-lan"
	config_get easytier_iface main easytier_iface "easytier0"
	config_get phone_subnet main phone_subnet "10.0.0.0/8"
	config_get allowed_tv_ips main allowed_tv_ips ""
	config_list_foreach main allowed_tv_ips append_allowed_tv_ip
	config_get_bool debug main debug 0

	mkdir -p "$STATE_DIR"

	procd_open_instance
	procd_set_param command "$PROG" \
		-lan-iface "$lan_iface" \
		-easytier-iface "$easytier_iface" \
		-phone-subnet "$phone_subnet" \
		-allowed-tv-ips "$allowed_tv_ips" \
		-state-file "$STATE_FILE" \
		-pid-file "$PID_FILE"
	[ "$debug" -eq 1 ] && procd_append_param command -debug
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_set_param respawn 3600 5 5
	procd_close_instance
}

reload_service() {
	restart
}

service_triggers() {
	procd_add_reload_trigger remote-cast
}
